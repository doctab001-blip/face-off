# Required for fal.ai inpainting via /api/fal/proxy
FAL_KEY="key_id:key_secret"

# Required for Supabase auth/data (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — only needed if you re-enable Clerk auth in layout.tsx
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
